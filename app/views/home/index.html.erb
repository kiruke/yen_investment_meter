<div class="container mx-auto px-4 py-8">
  <div class="max-w-2xl mx-auto">
    
    <!-- 既存のコンテンツ... -->
    
    <!-- 💰 貯金額比較フォーム -->
    <div class="bg-white rounded-lg shadow-lg p-6 mt-8">
      <h2 class="text-2xl font-bold text-gray-800 mb-6">
        💰 貯金の価値変化チェッカー
      </h2>
      
      <% if @rates_available %>
        <div class="bg-blue-50 p-4 rounded-lg mb-6">
          <p class="text-sm text-gray-600 mb-2">
            <strong>比較期間:</strong> 
            <%= @five_years_ago_rate.price_date.strftime('%Y年%m月%d日') %> 
            ～ 
            <%= @current_rate.price_date.strftime('%Y年%m月%d日') %>
          </p>
          <p class="text-sm text-gray-600">
            <strong>為替レート変化:</strong> 
            <%= number_with_precision(@five_years_ago_rate.price, precision: 2) %>円 
            → 
            <%= number_with_precision(@current_rate.price, precision: 2) %>円
            <span class="<%= @current_rate.price > @five_years_ago_rate.price ? 'text-red-600' : 'text-green-600' %>">
              (<%= @current_rate.price > @five_years_ago_rate.price ? '円安' : '円高' %>)
            </span>
          </p>
        </div>
        
        <%= form_with url: savings_compare_path, method: :post, local: true, class: "space-y-4" do |f| %>
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">
              現在の貯金額（円）
            </label>
            <div class="relative">
              <%= f.number_field :savings_amount, 
                  placeholder: "例: 1000000", 
                  class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
                  min: 1,
                  step: 1,
                  required: true %>
              <span class="absolute right-3 top-3 text-gray-500">円</span>
            </div>
            <p class="text-xs text-gray-500 mt-1">
              ※ 5年前の同じ金額と比較して、購買力の変化を計算します
            </p>
          </div>
          
          <button type="submit" 
                  class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition duration-200">
            💱 購買力の変化を計算する
          </button>
        <% end %>
        
      <% else %>
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
          <p class="text-yellow-800">
            ⚠️ 為替データが不足しています。
            <br>
            <%= link_to "データを取得", "#", class: "text-blue-600 hover:underline" %>
            してから再度お試しください。
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>